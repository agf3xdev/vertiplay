// Vertiplay — schema do banco
// Modelo de coins inspirado em DramaBox/ReelShort:
//   coinsPaid (compradas) + coinsBonus (rewards/check-in) — consumidas nessa ordem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique  // @arroba pública pra busca/amigos
  displayName   String   @default("")
  email         String   @unique
  name          String?
  avatarUrl     String?
  bio           String?
  coinsPaid     Int      @default(0)
  coinsBonus    Int      @default(50) // bônus de boas-vindas
  isVip         Boolean  @default(false)
  vipExpiresAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime @default(now())

  unlocks       Unlock[]
  watchlist     Watchlist[]
  checkins      Checkin[]
  transactions  Transaction[]
  progress      WatchProgress[]
  friendsFrom   Friendship[] @relation("FriendshipFrom")
  friendsTo     Friendship[] @relation("FriendshipTo")
}

// Pedidos/amizades entre users — pending até accept.
model Friendship {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  status    String   @default("pending") // "pending" | "accepted"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from      User     @relation("FriendshipFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("FriendshipTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([status])
}

// Códigos OTP de login por email — TTL 10min, max 5 tentativas.
model OtpCode {
  id         String   @id @default(cuid())
  email      String
  codeHash   String   // SHA-256 do código (não armazenar plain)
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([email]) // 1 código ativo por email (upsert)
  @@index([expiresAt])
}

// Login por senha — só pra admin, alternativa ao Google/OTP quando um dos
// dois estiver indisponível. Hash scrypt (node:crypto, sem dependência nova).
model AdminCredential {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Ledger de eventos de pagamento (Stripe + Mercado Pago).
model LedgerEntry {
  id         String   @id @default(cuid())
  source     String   // "stripe" | "mp"
  type       String   // "payment" | "ignored" | "error" | "signature_invalid"
  paymentId  String?
  status     String?
  amount     Float?
  method     String?
  userId     String?
  kind       String?
  meta       Json?
  at         DateTime @default(now())

  @@index([source, at])
  @@index([paymentId])
}

model Series {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  synopsis      String
  posterUrl     String
  bannerUrl     String?
  genre         String   // "Amor Proibido" | "Lobisomem" | "Vingança" | "CEO" | "Identidade Oculta" | etc
  tags          String   // CSV: bilionario,alfa,vinganca
  language      String   @default("pt-BR")
  isDubbed      Boolean  @default(true)
  views         Int      @default(0)
  rating        Float    @default(0)
  totalEpisodes Int      @default(0)
  freeEpisodes  Int      @default(3) // primeiros N grátis (estilo ReelShort)
  isFeatured    Boolean  @default(false)
  isExclusive   Boolean  @default(false)
  releaseAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  episodes      Episode[]
  watchlist     Watchlist[]
}

model Episode {
  id          String   @id @default(cuid())
  seriesId    String
  number      Int
  title       String
  durationSec Int
  videoUrl    String   // HLS .m3u8 ou MP4
  thumbUrl    String
  costCoins   Int      @default(20)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())

  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  unlocks     Unlock[]
  progress    WatchProgress[]

  @@unique([seriesId, number])
}

model Unlock {
  id         String   @id @default(cuid())
  userId     String
  episodeId  String
  coinsSpent Int
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
}

model WatchProgress {
  id         String   @id @default(cuid())
  userId     String
  episodeId  String
  positionSec Int      @default(0)
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model Checkin {
  id        String   @id @default(cuid())
  userId    String
  day       String   // YYYY-MM-DD
  reward    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  kind       String   // "purchase" | "unlock" | "checkin" | "bonus" | "vip" | "shop"
  coinsPaid  Int      @default(0)
  coinsBonus Int      @default(0)
  amountBRL  Int      @default(0) // centavos
  note       String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────────────────────
// SHOP LAYER — marcas patrocinadoras, catálogo por série, carrinho
// Diferencial Vertiplay: shoppable drama (estilo "ver na cena → comprar").
// ──────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoUrl     String
  coverUrl    String?
  bio         String
  website     String?
  category    String   // "Moda" | "Casa" | "Beleza" | "Eletro" | "Joias" | ...
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  products    Product[]
  sponsorships SeriesSponsorship[]
}

model Product {
  id            String   @id @default(cuid())
  brandId       String
  slug          String   @unique
  name          String
  description   String
  imageUrl      String
  gallery       String   // CSV de URLs extras
  priceBRL      Int      // centavos
  oldPriceBRL   Int?     // centavos (riscado)
  currency      String   @default("BRL")
  category      String   // "Vestido" | "Sofá" | "Perfume" | "Relógio" | ...
  stock         Int      @default(50)
  rating        Float    @default(4.7)
  affiliateUrl  String?  // link externo opcional
  createdAt     DateTime @default(now())

  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  appearances   ProductAppearance[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

// "Tal produto aparece na série X, episódio Y" — alimenta a sacolinha do player
model ProductAppearance {
  id         String   @id @default(cuid())
  productId  String
  seriesId   String
  episodeId  String?  // opcional (NULL = aparece em vários eps)
  sceneNote  String?  // ex: "Vestido da Helena no jantar"
  timestampSec Int?
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Patrocínio de uma marca em uma série (briefing comercial)
model SeriesSponsorship {
  id         String   @id @default(cuid())
  brandId    String
  seriesId   String
  tier       String   @default("standard") // "headline" | "standard"
  startAt    DateTime @default(now())
  endAt      DateTime?
  createdAt  DateTime @default(now())

  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, seriesId])
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  qty        Int      @default(1)
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  totalBRL    Int
  status      String   @default("pending") // "pending" | "paid" | "shipped" | "delivered"
  paymentRef  String?  // ID Stripe/MercadoPago
  addressJson String?  // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       OrderItem[]
}

// Histórias enviadas pelos usuários — pipeline de roteiros UGC
model StorySubmission {
  id          String   @id @default(cuid())
  authorName  String
  email       String?
  phone       String?
  title       String
  genre       String?  // sugestão do gênero
  synopsis    String   // resumo da história
  inspiration String?  // baseada em fato real? em livro? autoral?
  consent     Boolean  @default(false) // permissão pra usar
  status      String   @default("pending") // pending | reviewing | approved | rejected
  createdAt   DateTime @default(now())
}

// Seleção de histórias para novelas verticais — chamada aberta pra novos
// autores (diferente do StorySubmission, que é UGC pontual e informal).
model WriterApplication {
  id               String   @id @default(cuid())
  name             String   // nome completo
  artisticName     String?  // nome artístico, opcional
  email            String
  phone            String   // telefone
  cityState        String   // cidade / estado
  portfolioUrl     String?  // Instagram/portfólio, opcional
  workTitle        String   // título da obra
  scriptGenre      String   // "Drama" | "Romance" | "Comédia Romântica"
  synopsis         String   // sinopse — apresentação clara e objetiva da história
  argumentFileUrl  String   // path no bucket privado Supabase Storage "roteiros" — PDF, obrigatório
  argumentFileName String   // nome original do arquivo, pra exibir no admin
  consent          Boolean  @default(false) // aceite do Termo de Ciência e Responsabilidade
  status           String   @default("pending") // pending | reviewing | approved | rejected
  createdAt        DateTime @default(now())
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  qty        Int
  unitPriceBRL Int
  brandSlug  String   // snapshot
  productName String  // snapshot

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}
